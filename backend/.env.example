# Google Gemini API Key for generation (required)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string for user auth and kit persistence (required)
MONGODB_URI=your_mongodb_connection_string_here

# Secret key used for signing JWT tokens in authentication (required)
JWT_SECRET=your_super_secret_jwt_key_here

# Allow web crawler to hit localhost/private IPs (used for batch testing local sites)
ALLOW_PRIVATE_HOSTS=true

# Port for the Express server (optional, defaults to 4000)
PORT=4000
