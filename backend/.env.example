# LLM Provider API Keys (Set the ones you want to use in the fallback chain)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# MongoDB Configuration (required)
# You can define the connection details separately to avoid special character escaping issues:
MONGO_USER=your_db_username
MONGO_PASSWORD=your_db_password
MONGO_HOST=cluster0.cr8uaun.mongodb.net
MONGO_DB=trao_db

# Alternatively, you can provide the full connection string directly as an override:
# MONGODB_URI=mongodb+srv://user:pass@cluster0.cr8uaun.mongodb.net/trao_db?retryWrites=true&w=majority

# Secret key used for signing JWT tokens in authentication (required)
JWT_SECRET=your_super_secret_jwt_key_here

# Allow web crawler to hit localhost/private IPs (used for batch testing local sites)
ALLOW_PRIVATE_HOSTS=true

# Port for the Express server (optional, defaults to 4000)
PORT=4000
